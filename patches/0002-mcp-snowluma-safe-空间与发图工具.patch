+// ── QQ 空间（不需要模拟器：直接走网关的 qzone 接口）────────────────────────
+// 为什么放在桥接侧：手机/模拟器只负责“看屏幕”，空间操作走 QQ 账号自身的接口更稳，
+// 也不受模拟器没登录 QQ 的影响。
+const QZONE_LIKE_LIMIT = { perMinute: 3, perDay: 20, hits: [] };
+const QZONE_COMMENT_LIMIT = { per10Min: 1, perDay: 3, hits: [] };
+const QZONE_VISIT_LIMIT = { per3Min: 5, perDay: 40, hits: [] };
+const QZONE_POST_LIMIT = { per30Min: 1, perDay: 2, hits: [] };
+
+function qzoneLimit(kind) {
+  const now = Date.now();
+  if (kind === 'like') {
+    QZONE_LIKE_LIMIT.hits = QZONE_LIKE_LIMIT.hits.filter((t) => now - t < 24 * 3600 * 1000);
+    if (QZONE_LIKE_LIMIT.hits.filter((t) => now - t < 60000).length >= QZONE_LIKE_LIMIT.perMinute) {
+      return '【限流】点赞每分钟最多 3 次，等一会儿再来';
+    }
+    if (QZONE_LIKE_LIMIT.hits.length >= QZONE_LIKE_LIMIT.perDay) return '【限流】今天点赞次数用完了';
+    QZONE_LIKE_LIMIT.hits.push(now);
+    return null;
+  }
+  if (kind === 'comment') {
+    QZONE_COMMENT_LIMIT.hits = QZONE_COMMENT_LIMIT.hits.filter((t) => now - t < 24 * 3600 * 1000);
+    if (QZONE_COMMENT_LIMIT.hits.filter((t) => now - t < 10 * 60 * 1000).length >= QZONE_COMMENT_LIMIT.per10Min) {
+      return '【限流】评论每 10 分钟最多 1 条（发出去撤不回，宁可少发）';
+    }
+    if (QZONE_COMMENT_LIMIT.hits.length >= QZONE_COMMENT_LIMIT.perDay) return '【限流】今天评论次数用完了';
+    QZONE_COMMENT_LIMIT.hits.push(now);
+    return null;
+  }
+  if (kind === 'post') {
+    QZONE_POST_LIMIT.hits = QZONE_POST_LIMIT.hits.filter((t) => now - t < 24 * 3600 * 1000);
+    if (QZONE_POST_LIMIT.hits.filter((t) => now - t < 30 * 60 * 1000).length >= QZONE_POST_LIMIT.per30Min) {
+      return '【限流】说说每 30 分钟最多 1 条，别刷屏';
+    }
+    if (QZONE_POST_LIMIT.hits.length >= QZONE_POST_LIMIT.perDay) return '【限流】今天说说条数用完了（每天最多 3 条）';
+    QZONE_POST_LIMIT.hits.push(now);
+    return null;
+  }
+  QZONE_VISIT_LIMIT.hits = QZONE_VISIT_LIMIT.hits.filter((t) => now - t < 24 * 3600 * 1000);
+  if (QZONE_VISIT_LIMIT.hits.filter((t) => now - t < 3 * 60 * 1000).length >= QZONE_VISIT_LIMIT.per3Min) {
+    return '【限流】翻空间翻太快会被 QQ 风控，3 分钟最多看 5 个人，歇会儿';
+  }
+  if (QZONE_VISIT_LIMIT.hits.length >= QZONE_VISIT_LIMIT.perDay) return '【限流】今天逛空间到上限了';
+  QZONE_VISIT_LIMIT.hits.push(now);
+  return null;
+}
+
+function htmlToText(html) {
+  return String(html ?? '')
+    .replace(/<br\s*\/?>/gi, ' ')
+    .replace(/<[^>]+>/g, '')
+    .replace(/&nbsp;/gi, ' ')
+    .replace(/&amp;/gi, '&')
+    .replace(/&lt;/gi, '<')
+    .replace(/&gt;/gi, '>')
+    .replace(/&quot;/gi, '"')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
